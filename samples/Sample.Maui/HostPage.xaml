<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Sample.Maui"
    xmlns:emu="clr-namespace:Shiny.Obd.Emulator"
    x:Class="Sample.Maui.HostPage"
    x:DataType="local:HostViewModel"
    Title="OBD Adapter Emulator">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- Transport status -->
        <VerticalStackLayout Spacing="8">

            <!-- Which vehicle the emulator is. The VIN is real enough to decode, and everything else
                 on this screen follows from the choice. -->
            <Border Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="VEHICLE" FontSize="11" FontAttributes="Bold" TextColor="Gray" />
                    <Picker
                        ItemsSource="{Binding State.Vehicles}"
                        SelectedItem="{Binding State.Vehicle}"
                        ItemDisplayBinding="{Binding Name, x:DataType=emu:EmulatedVehicle}" />
                    <Label Text="{Binding State.Vehicle.Vin}" FontSize="13" FontFamily="Monospace" />
                    <Label Text="{Binding State.Vehicle.Decodes}" FontSize="12" />
                    <Label Text="{Binding State.Vehicle.Note}" FontSize="11" TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <!-- One card per registered transport. The emulator answers on all of them at once and
                 they share one vehicle, so a value set here is read back identically over each. -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Host.Transports}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="emu:IObdEmulatorTransport">
                        <Border Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontSize="11" FontAttributes="Bold" TextColor="Gray" />
                                <Label Text="{Binding Status}" FontSize="14" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Details}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}" FontSize="11" FontFamily="Monospace" TextColor="Gray" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="{Binding HostButtonText}" Command="{Binding ToggleHostCommand}" />

        </VerticalStackLayout>

        <!-- Connected clients -->
        <Border Grid.Row="1" Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
            <VerticalStackLayout Spacing="6">

                <Label Text="{Binding Host.ClientSummary}" FontSize="14" FontAttributes="Bold" />

                <Label
                    Text="Nothing is connected yet. Connect from the Scan tab on another device, or point an OBD app at one of the addresses above."
                    FontSize="11"
                    TextColor="Gray"
                    IsVisible="{Binding Host.HasNoClients}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Host.Clients}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="emu:HostedClient">
                            <VerticalStackLayout>
                                <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" />
                                <Label Text="{Binding Detail}" FontSize="11" TextColor="Gray" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

        <!-- Live command log -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="COMMAND LOG" FontSize="11" FontAttributes="Bold" TextColor="Gray" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Clear" Command="{Binding ClearLogCommand}" FontSize="12" Padding="12,4" HeightRequest="32" />
            </Grid>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Host.Log}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label
                        Text="Every AT command and PID request will appear here as it arrives."
                        HorizontalTextAlignment="Center"
                        VerticalOptions="Center"
                        TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="emu:ObdLogEntry">
                        <VerticalStackLayout Padding="0,4">
                            <Label Text="{Binding Title}" FontSize="12" FontFamily="Monospace" />
                            <Label Text="{Binding Detail}" FontSize="11" TextColor="Gray" FontFamily="Monospace" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

    </Grid>
</ContentPage>
