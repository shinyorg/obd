<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<key>UILaunchStoryboardName</key>
	<string>MauiSplash</string>
	<!-- No UIBackgroundModes on purpose. Adding bluetooth-central / bluetooth-peripheral here is what
	     lets iOS keep scanning, connections and GATT advertising alive once the app is backgrounded,
	     and this sample has no reason to: it is a foreground scan tool. Leave this out, and leave
	     AppleBleConfiguration.RestoreIdentifier unset in MauiProgram - the restore identifier only
	     does anything with the background mode declared, and setting one implies an app that expects
	     to be relaunched into the background. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>This app uses Bluetooth to connect to your OBD-II vehicle adapter, and to act as one for testing.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>This app uses Bluetooth to advertise itself as an OBD-II adapter so other apps can connect to it.</string>
	<!-- The TCP/mDNS side of the emulator. Without the Bonjour service listed here iOS 14+ blocks the
	     advertisement outright rather than just prompting. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>This app publishes a simulated WiFi OBD-II adapter on your local network so other apps can find and connect to it.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_obd._tcp</string>
	</array>
</dict>
</plist>
