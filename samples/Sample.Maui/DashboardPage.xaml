<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Sample.Maui"
    x:Class="Sample.Maui.DashboardPage"
    x:DataType="local:DashboardViewModel"
    Title="{Binding DeviceName}">

    <!--
        The gauges ride in the CollectionView header rather than in a ScrollView above it: the command
        list is a few hundred rows, and a virtualising list nested in a scroll view loses its
        virtualisation and measures every row.
    -->
    <CollectionView ItemsSource="{Binding Runs}" SelectionMode="None">

        <CollectionView.Header>
            <VerticalStackLayout Padding="16,16,16,8" Spacing="12">

                <!-- Status Bar -->
                <Border Padding="12" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}" Stroke="Transparent" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding AdapterInfo}" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding Status}" FontSize="14" />
                        <Button Text="{Binding ConnectionButtonText}" Command="{Binding ToggleConnectionCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Speed -->
                <Border Padding="16" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="SPEED" FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center" />
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="{Binding Speed}" FontSize="48" FontAttributes="Bold" />
                            <Label Text="km/h" FontSize="16" TextColor="Gray" VerticalOptions="End" Margin="0,0,0,10" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- RPM -->
                <Border Padding="16" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="ENGINE RPM" FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center" />
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="{Binding Rpm}" FontSize="48" FontAttributes="Bold" />
                            <Label Text="RPM" FontSize="16" TextColor="Gray" VerticalOptions="End" Margin="0,0,0,10" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Two Column Row: Coolant + Throttle -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="COOLANT" FontSize="11" TextColor="Gray" HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding CoolantTemp}" FontSize="32" FontAttributes="Bold" />
                                <Label Text="°C" FontSize="14" TextColor="Gray" VerticalOptions="End" Margin="0,0,0,6" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="THROTTLE" FontSize="11" TextColor="Gray" HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding Throttle}" FontSize="32" FontAttributes="Bold" />
                                <Label Text="%" FontSize="14" TextColor="Gray" VerticalOptions="End" Margin="0,0,0,6" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Two Column Row: Fuel + Engine Load -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="FUEL LEVEL" FontSize="11" TextColor="Gray" HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding FuelLevel}" FontSize="32" FontAttributes="Bold" />
                                <Label Text="%" FontSize="14" TextColor="Gray" VerticalOptions="End" Margin="0,0,0,6" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="ENGINE LOAD" FontSize="11" TextColor="Gray" HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding EngineLoad}" FontSize="32" FontAttributes="Bold" />
                                <Label Text="%" FontSize="14" TextColor="Gray" VerticalOptions="End" Margin="0,0,0,6" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Everything else Shiny.Obd can ask for, on demand rather than on a poll loop -->
                <Border Padding="12" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}" Stroke="Transparent" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="6">

                        <Label Text="ALL COMMANDS" FontSize="11" FontAttributes="Bold" TextColor="Gray" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Text="{Binding ReadButtonText}" Command="{Binding ReadCommand}" />
                            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsReading}" IsVisible="{Binding IsReading}" VerticalOptions="Center" />
                        </Grid>

                        <Label Text="{Binding LastRead}" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding ReadStatus}" FontSize="12" />

                        <!-- Reading everything is safe. Clearing is not, so it sits apart and takes two taps. -->
                        <Button
                            Text="{Binding ClearButtonText}"
                            Command="{Binding ClearDtcsCommand}"
                            BackgroundColor="IndianRed"
                            FontSize="13"
                            HeightRequest="38" />

                        <HorizontalStackLayout Spacing="8">
                            <Switch IsToggled="{Binding ProbeUnsupported}" VerticalOptions="Center" />
                            <Label
                                Text="Ask for unsupported PIDs too"
                                FontSize="12"
                                TextColor="Gray"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <SearchBar Placeholder="Filter by name, group or request (eg 010C)" Text="{Binding Search}" />

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:ObdCommandRun">
                <Border Margin="16,4" Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="4">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" />
                                <Label Text="{Binding Group}" FontSize="10" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="1"
                                Text="{Binding StateText}"
                                TextColor="{Binding StateColor}"
                                FontSize="11"
                                VerticalOptions="Center" />
                        </Grid>

                        <Label Text="{Binding Request, StringFormat='request {0}'}" FontSize="11" TextColor="Gray" FontFamily="Monospace" />

                        <Label
                            Text="{Binding Value}"
                            IsVisible="{Binding HasValue}"
                            FontSize="13"
                            FontFamily="Monospace" />

                        <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="11" TextColor="Gray" />

                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="16" Color="Transparent" />
        </CollectionView.Footer>

    </CollectionView>
</ContentPage>
