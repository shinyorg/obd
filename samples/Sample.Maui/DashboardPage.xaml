<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Sample.Maui"
    x:Class="Sample.Maui.DashboardPage"
    x:DataType="local:DashboardViewModel"
    Title="{Binding DeviceName}">

    <!--
        The gauges ride in the CollectionView header rather than in a ScrollView above it: the command
        list is a few hundred rows, and a virtualising list nested in a scroll view loses its
        virtualisation and measures every row.
    -->
    <CollectionView ItemsSource="{Binding Runs}" SelectionMode="None">

        <CollectionView.Header>
            <VerticalStackLayout Padding="16,16,16,8" Spacing="12">

                <!-- Status Bar -->
                <Border Padding="12" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}" Stroke="Transparent" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding AdapterInfo}" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding Status}" FontSize="14" />
                        <Button Text="{Binding ConnectionButtonText}" Command="{Binding ToggleConnectionCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Gauge picker: up to eight of the catalog, in the order they were tapped -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Text="{Binding GaugePickerText}" Command="{Binding ToggleGaugePickerCommand}" />
                    <Button
                        Grid.Column="1"
                        Text="Reset"
                        Command="{Binding ResetGaugesCommand}"
                        IsVisible="{Binding IsPickingGauges}"
                        Padding="16,0" />
                </Grid>

                <FlexLayout
                    BindableLayout.ItemsSource="{Binding GaugeOptions}"
                    IsVisible="{Binding IsPickingGauges}"
                    Wrap="Wrap"
                    JustifyContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:GaugeOption">
                            <Border
                                Margin="0,0,6,6"
                                Padding="12,6"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 14"
                                IsEnabled="{Binding CanSelect}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding CanSelect}" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding ToggleGaugeCommand, Source={RelativeSource AncestorType={x:Type local:DashboardViewModel}}, x:DataType=local:DashboardViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Title}" FontSize="12">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!--
                    The cluster. Two per row; Basis 50% rather than a Grid because the count changes as
                    gauges are picked, and a FlexLayout wraps without per-item row/column bookkeeping.
                -->
                <FlexLayout BindableLayout.ItemsSource="{Binding Gauges}" Wrap="Wrap" JustifyContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:GaugeTile">
                            <Border
                                FlexLayout.Basis="50%"
                                Margin="4"
                                Padding="4"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 8">
                                <Grid>
                                    <!-- Value binds straight through: the gauge's spring smooths the 2 Hz poll, a view-model tween would fight it. -->
                                    <local:ObdGauge
                                        Definition="{Binding Definition}"
                                        Value="{Binding Value}"
                                        SweepOnLoad="True"
                                        HeightRequest="150"
                                        WidthRequest="150"
                                        HorizontalOptions="Center">
                                        <local:ObdGauge.Triggers>
                                            <DataTrigger TargetType="local:ObdGauge" Binding="{Binding HasReading}" Value="False">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                        </local:ObdGauge.Triggers>
                                    </local:ObdGauge>
                                    <Label
                                        Text="NO DATA"
                                        IsVisible="{Binding NoReading}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="Gray"
                                        HorizontalOptions="Center"
                                        VerticalOptions="End"
                                        Margin="0,0,0,4" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Everything else Shiny.Obd can ask for, on demand rather than on a poll loop -->
                <Border Padding="12" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}" Stroke="Transparent" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="6">

                        <Label Text="ALL COMMANDS" FontSize="11" FontAttributes="Bold" TextColor="Gray" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Text="{Binding ReadButtonText}" Command="{Binding ReadCommand}" />
                            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsReading}" IsVisible="{Binding IsReading}" VerticalOptions="Center" />
                        </Grid>

                        <Label Text="{Binding LastRead}" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding ReadStatus}" FontSize="12" />

                        <!-- Reading everything is safe. Clearing is not, so it sits apart and takes two taps. -->
                        <Button
                            Text="{Binding ClearButtonText}"
                            Command="{Binding ClearDtcsCommand}"
                            BackgroundColor="IndianRed"
                            FontSize="13"
                            HeightRequest="38" />

                        <HorizontalStackLayout Spacing="8">
                            <Switch IsToggled="{Binding ProbeUnsupported}" VerticalOptions="Center" />
                            <Label
                                Text="Ask for unsupported PIDs too"
                                FontSize="12"
                                TextColor="Gray"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <SearchBar Placeholder="Filter by name, group or request (eg 010C)" Text="{Binding Search}" />

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:ObdCommandRun">
                <Border Margin="16,4" Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="4">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" />
                                <Label Text="{Binding Group}" FontSize="10" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="1"
                                Text="{Binding StateText}"
                                TextColor="{Binding StateColor}"
                                FontSize="11"
                                VerticalOptions="Center" />
                        </Grid>

                        <Label Text="{Binding Request, StringFormat='request {0}'}" FontSize="11" TextColor="Gray" FontFamily="Monospace" />

                        <Label
                            Text="{Binding Value}"
                            IsVisible="{Binding HasValue}"
                            FontSize="13"
                            FontFamily="Monospace" />

                        <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="11" TextColor="Gray" />

                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="16" Color="Transparent" />
        </CollectionView.Footer>

    </CollectionView>
</ContentPage>
