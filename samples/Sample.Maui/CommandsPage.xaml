<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Sample.Maui"
    x:Class="Sample.Maui.CommandsPage"
    x:DataType="local:CommandsViewModel"
    Title="All Commands">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="8">

        <VerticalStackLayout Spacing="6">

            <Border Padding="12" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}" Stroke="Transparent" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding AdapterInfo}" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding Status}" FontSize="13" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Text="{Binding SweepButtonText}" Command="{Binding SweepCommand}" />
                        <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsSweeping}" IsVisible="{Binding IsSweeping}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Reading everything is safe. Clearing is not, so it sits apart and takes two taps. -->
                    <Button
                        Text="{Binding ClearButtonText}"
                        Command="{Binding ClearDtcsCommand}"
                        BackgroundColor="IndianRed"
                        FontSize="13"
                        HeightRequest="38" />

                    <HorizontalStackLayout Spacing="8">
                        <Switch IsToggled="{Binding ProbeUnsupported}" VerticalOptions="Center" />
                        <Label
                            Text="Ask for unsupported PIDs too"
                            FontSize="12"
                            TextColor="Gray"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <SearchBar Placeholder="Filter by name, group or request (eg 010C)" Text="{Binding Search}" />
            <Label Text="{Binding Summary}" FontSize="12" TextColor="Gray" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Runs}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ObdCommandRun">
                    <Border Margin="0,4" Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="4">

                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="{Binding Group}" FontSize="10" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding StateText}"
                                    TextColor="{Binding StateColor}"
                                    FontSize="11"
                                    VerticalOptions="Center" />
                            </Grid>

                            <Label Text="{Binding Request, StringFormat='request {0}'}" FontSize="11" TextColor="Gray" FontFamily="Monospace" />

                            <Label
                                Text="{Binding Value}"
                                IsVisible="{Binding HasValue}"
                                FontSize="13"
                                FontFamily="Monospace" />

                            <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="11" TextColor="Gray" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
