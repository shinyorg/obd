<?xml version="1.0" encoding="UTF-8"?>
<shiny:ShinyShell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:local="clr-namespace:Sample.Maui"
                  xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
                  x:Class="Sample.Maui.AppShell"
                  Title="OBD Sample">

    <TabBar>

        <!-- Client role: find and read a real adapter -->
        <ShellContent Title="Scan"
                      ContentTemplate="{DataTemplate local:ScanPage}"
                      Route="scan" />

        <!-- Adapter role: be the adapter, over BLE and TCP at once -->
        <ShellContent Title="Adapter"
                      ContentTemplate="{DataTemplate local:HostPage}"
                      Route="host" />

        <!-- Play a drive into the emulator so the values move on their own -->
        <ShellContent Title="Drive"
                      ContentTemplate="{DataTemplate local:DrivePage}"
                      Route="drive" />

        <ShellContent Title="Values"
                      ContentTemplate="{DataTemplate local:ParametersPage}"
                      Route="values" />

        <ShellContent Title="Faults"
                      ContentTemplate="{DataTemplate local:FaultsPage}"
                      Route="faults" />

    </TabBar>

</shiny:ShinyShell>
