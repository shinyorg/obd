<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Shiny.Obd.Serial</RootNamespace>
        <Description>Serial (USB/UART) transport for Shiny.Obd - works on Windows, Linux and macOS</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Obd\Shiny.Obd.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Obd.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all"/>
        <PackageReference Include="System.IO.Ports"/>
    </ItemGroup>
</Project>
